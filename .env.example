# Salin file ini menjadi .env.local untuk development di komputer Anda.
# Nilai-nilai ini didapat otomatis dari dashboard Vercel setelah Anda
# menambahkan database Redis (via Storage > Marketplace) dan menghubungkannya
# ke proyek ini (lihat langkah-langkah di README.md).
# Tergantung versi integrasi, nama variabelnya salah satu dari dua pasang ini:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# atau:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
